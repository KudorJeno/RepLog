# RevenueCat public SDK key for Android (Project settings > API keys > Google Play).
# For local dev copy this file to .env.local; for store builds set it as an EAS environment variable:
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_KEY --value goog_xxx --environment production --visibility sensitive
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
